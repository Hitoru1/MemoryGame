<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ImageView placed behind the TextViews -->
    <ImageView
        android:id="@+id/mainImage"
        android:layout_width="803dp"
        android:layout_height="1281dp"
        android:scaleType="centerCrop"
        android:src="@drawable/medium_level"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <!-- TextView for player name -->
    <!-- Added elevation to ensure it is above other elements -->

    <!-- TextView for difficulty -->
    <!-- Added elevation to ensure it is above other elements -->

    <!-- Back Button -->

    <TextView
        android:id="@+id/playerNameTextView"
        android:layout_width="165dp"
        android:layout_height="42dp"
        android:layout_margin="16dp"
        android:elevation="10dp"
        android:fontFamily="sans-serif-black"
        android:text=" "
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintVertical_bias="0.214" />

    <TextView
        android:id="@+id/difficultyTextView"
        android:layout_width="215dp"
        android:layout_height="34dp"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:elevation="10dp"
        android:text=""
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerNameTextView" />

    <!--delete this-->

    <TextView
        android:id="@+id/timerTextView"
        android:layout_width="119dp"
        android:layout_height="52dp"
        android:text="01:20"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/mainImage"
        app:layout_constraintHorizontal_bias="0.531"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintVertical_bias="0.143" />

    <TextView
        android:id="@+id/flipCounter"
        android:layout_width="109dp"
        android:layout_height="84dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="1120dp"
        android:paddingBottom="16dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.641"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="431dp"
        android:layout_height="433dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="@+id/mainImage"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintVertical_bias="0.451">

        <!-- 12 ImageButtons -->
        <ImageButton
            android:id="@+id/card_0"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_1"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_2"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_3"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_4"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_5"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_6"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_7"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_8"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_9"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_10"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_11"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_12"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_13"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_14"
            style="@style/CardStyle" />

        <ImageButton
            android:id="@+id/card_15"
            style="@style/CardStyle" />


    </GridLayout>

    <Button
        android:id="@+id/backbtn"
        android:layout_width="92dp"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/mainImage"
        app:layout_constraintHorizontal_bias="0.172"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.013"
        tools:ignore="MissingConstraints" />

    <!-- Pause Button -->
    <Button
        android:id="@+id/pause"
        android:layout_width="94dp"
        android:layout_height="67dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.822"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintVertical_bias="0.005" />

</androidx.constraintlayout.widget.ConstraintLayout>